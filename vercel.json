{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/calender",
      "schedule": "0 20 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/jubilee",
      "destination": "https://jubilee.n2freevas.com/",
      "permanent": true
    },
    {
      "source": "/jubilee/:path*",
      "destination": "https://jubilee.n2freevas.com/:path*",
      "permanent": true
    }
  ]
}
