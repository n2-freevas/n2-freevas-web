{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/calender",
      "schedule": "0 20 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/jubilee",
      "destination": "https://jubilee-web.vercel.app/jubilee"
    },
    {
      "source": "/jubilee/:path*",
      "destination": "https://jubilee-web.vercel.app/jubilee/:path*"
    }
  ]
}
