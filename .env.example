# ローカル開発用の環境変数の例。.env にコピーして値を入れる（.env は git 管理外）。
# 本番・プレビューの値は Vercel の Environment Variables に設定する。

# jubilee/replay で Google Drive の動画を読み込む API キー（ブラウザに公開される。Drive API のみ・許可サイトのみに制限すること）
PUBLIC_GDRIVE_API_KEY=

# ───── jubilee のログイン（サーバー側だけで使う）─────
# どれかが未設定なら jubilee には誰も入れない。
# Vercel のプレビュー環境ではログインを省き、Vercel の Deployment Protection に任せる。

# Google ログインの OAuth クライアント（Google Cloud Console で作成。戻り先: <origin>/jubilee/auth/callback）
JUBILEE_GOOGLE_OAUTH_CLIENT_ID=
JUBILEE_GOOGLE_OAUTH_CLIENT_SECRET=
# ログイン状態（Cookie）の署名鍵。32 文字以上のランダムな文字列（例: openssl rand -base64 48）
JUBILEE_SESSION_SECRET=
# 許可リストを置く Vercel Global Config（旧名 Edge Config）の接続文字列（`vercel env pull` で取得できる）
GLOBAL_CONFIG=

# ───── .claude/skills/jubilee-member で許可リストを編集するとき ─────
# Vercel CLI のログインを使い、Global Config のストアを編集する。既定と違うときだけ書く。
# Vercel のアカウントに複数のチームがあるときは JUBILEE_VERCEL_SCOPE が必要。
# JUBILEE_GLOBAL_CONFIG=n2-freevas-web-global-config
# JUBILEE_VERCEL_SCOPE=
# JUBILEE_VERCEL_CLI=npx --yes vercel@65.16.0

# ───── /calender（予定の時間帯だけを公開する週間カレンダー。サーバー側だけで使う）─────
# どちらも未設定なら空のカレンダーになる。URL・トークンを知っていれば予定の中身まで読めるので、絶対に公開しない。

# iCal(ICS) の URL。改行かカンマ区切りで複数書ける
#   Google カレンダー: 設定 → 各カレンダー → 「カレンダーの統合」→「iCal 形式の非公開アドレス」（カレンダーごとに 1 つ）
#   iCloud(iOS)カレンダー: カレンダー App で共有 →「公開カレンダー」をオン → 表示された webcal:// の URL
CALENDER_ICS_URLS=
# テニスベアのログイントークン。www.tennisbear.net にログインしたブラウザの Cookie「tb_token」の値（約 3 年有効）
CALENDER_TENNISBEAR_TOKEN=

# cron（vercel.json）が毎朝 5 時台に集めた時間帯の置き場所（Vercel Blob）。
# Vercel のプロジェクトに Blob のストア（Private）をつなぐと BLOB_STORE_ID が自動で設定され、認証は Vercel の OIDC で行われる。
# ローカル開発（npm run dev）では値があっても Blob は使わず、開発サーバーのメモリに置く（/api/cron/calender を開くと集め直す）
BLOB_STORE_ID=
# Vercel Cron だけが /api/cron/calender を動かせるようにする合言葉。16 文字以上のランダムな文字列（例: openssl rand -base64 32）
CRON_SECRET=
