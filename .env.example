# ローカル開発用の環境変数の例。.env にコピーして値を入れる（.env は git 管理外）。
# 本番・プレビューの値は Vercel の Environment Variables に設定する。

# jubilee/replay で Google Drive の動画を読み込む API キー（ブラウザに公開される。Drive API のみ・許可サイトのみに制限すること）
PUBLIC_GDRIVE_API_KEY=

# ───── jubilee のログイン（サーバー側だけで使う）─────
# どれかが未設定なら jubilee には誰も入れない。
# Vercel のプレビュー環境ではログインを省き、Vercel の Deployment Protection に任せる。

# Google ログインの OAuth クライアント（Google Cloud Console で作成。戻り先: <origin>/jubilee/auth/callback）
JUBILEE_GOOGLE_OAUTH_CLIENT_ID=
JUBILEE_GOOGLE_OAUTH_CLIENT_SECRET=
# ログイン状態（Cookie）の署名鍵。32 文字以上のランダムな文字列（例: openssl rand -base64 48）
JUBILEE_SESSION_SECRET=
# 許可リストを置く Vercel Global Config（旧名 Edge Config）の接続文字列（`vercel env pull` で取得できる）
GLOBAL_CONFIG=

# ───── .claude/skills/jubilee-member で許可リストを編集するとき ─────
# ふだんは不要（Vercel CLI のログインを使い、slug が jubilee のストアを編集する）。既定と違うときだけ書く。
# JUBILEE_GLOBAL_CONFIG=jubilee
# JUBILEE_VERCEL_SCOPE=
# JUBILEE_VERCEL_CLI=npx --yes vercel@65.16.0
